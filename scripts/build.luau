--!strict

local fs = require("@lune/fs")

local MODULES = {
	"Signal",
	"Geometry",
	"Element",
	"InputRouter",
	"Canvas",
	"Limn",
}

local output = {
	"-- Generated by scripts/build.luau. Do not edit.\n",
	"local __modules = {}\n",
	"local __cache = {}\n",
	"local function __require(name)\n",
	"\tif __cache[name] ~= nil then return __cache[name] end\n",
	'\tlocal loader = assert(__modules[name], "unknown Limn module " .. name)\n',
	"\tlocal value = loader()\n",
	"\t__cache[name] = value\n",
	"\treturn value\n",
	"end\n\n",
}

for _, name in MODULES do
	local source = fs.readFile(string.format("src/%s.luau", name))
	source = source:gsub("^%-%-!strict\r?\n", "")
	source = source:gsub('require%("%./([%w_]+)"%)', '__require("%1")')
	table.insert(output, string.format("__modules[%q] = function()\n%s\nend\n\n", name, source))
end

table.insert(output, 'return __require("Limn")\n')
fs.writeDir("dist")
fs.writeFile("dist/Limn.lua", table.concat(output))
print("Built dist/Limn.lua")
